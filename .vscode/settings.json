{
    // General
    "editor.wordWrap": "on",
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    // use indentation and not spaces
    "[makefile]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "editor.tabSize": 4
    },

    "files.associations": {
        "__locale": "cpp",
        "locale": "cpp"
    },

    // C++ macOS arm64
    "clangd.fallbackFlags": [
        "-I${workspaceFolder}/gcc-12.2.0/lib/gcc/aarch64-unknown-linux-gnu/12.2.0/plugin/include",
        "-I${workspaceFolder}/**",
        "-std=c++17",
        "-D_XOPEN_SOURCE=600",
    ],

    // Other
    "todo-tree.regex.regex": "(//|#|<!--|%|;| *|/\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS)",
    "todo-tree.highlights.useColourScheme": true,
}
